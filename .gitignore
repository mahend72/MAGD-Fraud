# --- Python / tooling caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
*.egg-info/

# --- Editor / assistant tooling (local-only, not part of the research artifact) ---
.claude/
.agents/

# --- Raw benchmark data and processed splits ---
# FiFAR is a public benchmark and is not redistributed here; see README "Dataset" section.
# data/processed/ holds intermediate train/val/test splits regenerated by the pipeline.
data/ICAIF_KAGGLE/
data/raw/
data/processed/

# --- Archived / superseded experiment snapshots ---
# Full point-in-time copies of data/outputs/ kept only for local debugging history.
data/outputs_archive_pre_repair/

# --- Large regenerable per-case outputs under data/outputs/ ---
# Row-per-case decision logs, embeddings, and raw score/prediction dumps.
# Summary metrics, paper tables, policy configs, and figure data stay tracked.
data/outputs/assurance/embeddings_*.csv
data/outputs/assurance/distance_uncertainty.csv
data/outputs/assurance/calibration_risk.csv
data/outputs/assurance/wrong_confident_risk.csv
data/outputs/assurance/numerical_confidence.csv
data/outputs/assurance/magd_risk.csv
data/outputs/assurance/local_reliability.csv
data/outputs/assurance/test_assurance_base.csv

data/outputs/ablations/ablation_decisions_*.csv

data/outputs/assurance_deferral/*_decisions.csv

data/outputs/final_reproducible_run/decision_logs/
data/outputs/final_reproducible_run/magd_v2_test_decisions.csv

data/outputs/audit_pack/decision_audit_log.csv
data/outputs/audit_pack/decision_logs.csv

data/outputs/baselines/*_decisions.csv
data/outputs/baselines/*_budget_scores.csv

data/outputs/model/*_predictions.csv
